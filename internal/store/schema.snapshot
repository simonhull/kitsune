-- table tracks_fts
CREATE VIRTUAL TABLE tracks_fts USING fts5 (
	title, artists, album, album_artist,
	content = '', contentless_delete = 1,
	tokenize = 'unicode61 remove_diacritics 2'
);
--   column cid=0 name=title type= notnull=0 dflt_value=<nil> pk=0 hidden=0
--   column cid=1 name=artists type= notnull=0 dflt_value=<nil> pk=0 hidden=0
