-- table track_hearts
CREATE TABLE track_hearts (
	user_id    INTEGER NOT NULL REFERENCES users (id) ON DELETE CASCADE,
	track_id   INTEGER NOT NULL REFERENCES tracks (id) ON DELETE CASCADE,
	hearted_at INTEGER NOT NULL, -- the first heart: hearting again keeps it
	PRIMARY KEY (user_id, track_id)
) STRICT, WITHOUT ROWID;
--   column cid=0 name=user_id type=INTEGER notnull=1 dflt_value=<nil> pk=1 hidden=0
--   column cid=1 name=track_id type=INTEGER notnull=1 dflt_value=<nil> pk=2 hidden=0
--   column cid=2 name=hearted_at type=INTEGER notnull=1 dflt_value=<nil> pk=0 hidden=0
--   foreign key id=0 seq=0 table=tracks from=track_id to=id on_update=NO ACTION on_delete=CASCADE match=NONE
--   foreign key id=1 seq=0 table=users from=user_id to=id on_update=NO ACTION on_delete=CASCADE match=NONE

-- index track_hearts_track
CREATE INDEX track_hearts_track ON track_hearts (track_id);
--   key seqno=0 cid=1 name=track_id desc=0 coll=BINARY key=1
--   key seqno=1 cid=0 name=user_id desc=0 coll=BINARY key=0

-- table track_ratings
CREATE TABLE track_ratings (
	user_id  INTEGER NOT NULL REFERENCES users (id) ON DELETE CASCADE,
	track_id INTEGER NOT NULL REFERENCES tracks (id) ON DELETE CASCADE,
	stars    INTEGER NOT NULL CHECK (stars BETWEEN 1 AND 5),
	rated_at INTEGER NOT NULL, -- the latest rating
	PRIMARY KEY (user_id, track_id)
) STRICT, WITHOUT ROWID;
--   column cid=0 name=user_id type=INTEGER notnull=1 dflt_value=<nil> pk=1 hidden=0
--   column cid=1 name=track_id type=INTEGER notnull=1 dflt_value=<nil> pk=2 hidden=0
--   column cid=2 name=stars type=INTEGER notnull=1 dflt_value=<nil> pk=0 hidden=0
