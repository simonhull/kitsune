-- table user_prefs
CREATE TABLE user_prefs (
	user_id    INTEGER NOT NULL REFERENCES users (id) ON DELETE CASCADE,
	key        TEXT    NOT NULL,
	value      TEXT    NOT NULL, -- JSON, checked by the key's rule before it is written
	updated_at INTEGER NOT NULL,
	PRIMARY KEY (user_id, key)
) STRICT, WITHOUT ROWID;
--   column cid=0 name=user_id type=INTEGER notnull=1 dflt_value=<nil> pk=1 hidden=0
--   column cid=1 name=key type=TEXT notnull=1 dflt_value=<nil> pk=2 hidden=0
--   column cid=2 name=value type=TEXT notnull=1 dflt_value=<nil> pk=0 hidden=0
