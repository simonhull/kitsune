-- table settings
CREATE TABLE settings (
	key        TEXT    PRIMARY KEY,
	value      TEXT    NOT NULL, -- JSON, checked by the key's rule before it is written
	source     TEXT    NOT NULL CHECK (source IN ('web', 'server.toml', 'env', 'flag')),
	updated_at INTEGER NOT NULL
) STRICT, WITHOUT ROWID;
--   column cid=0 name=key type=TEXT notnull=1 dflt_value=<nil> pk=1 hidden=0
--   column cid=1 name=value type=TEXT notnull=1 dflt_value=<nil> pk=0 hidden=0
