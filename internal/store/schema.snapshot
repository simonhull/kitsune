CREATE INDEX artist_hearts_artist ON artist_hearts (artist_id);
--   key seqno=0 cid=1 name=artist_id desc=0 coll=BINARY key=1
--   key seqno=1 cid=0 name=user_id desc=0 coll=BINARY key=0

-- table artists
CREATE TABLE artists (
	id        INTEGER PRIMARY KEY,
	ulid      TEXT    NOT NULL UNIQUE CHECK (length(ulid) = 26), -- public ID; kept across updates
	match_key TEXT    NOT NULL UNIQUE,  -- caller-normalized name; the identity
	name      TEXT    NOT NULL,
	sort_name TEXT    NOT NULL,
	mbid      TEXT                      -- NULL when unknown
) STRICT;
--   column cid=0 name=id type=INTEGER notnull=0 dflt_value=<nil> pk=1 hidden=0
--   column cid=1 name=ulid type=TEXT notnull=1 dflt_value=<nil> pk=0 hidden=0
--   column cid=2 name=match_key type=TEXT notnull=1 dflt_value=<nil> pk=0 hidden=0
--   column cid=3 name=name type=TEXT notnull=1 dflt_value=<nil> pk=0 hidden=0
--   column cid=4 name=sort_name type=TEXT notnull=1 dflt_value=<nil> pk=0 hidden=0
--   column cid=5 name=mbid type=TEXT notnull=0 dflt_value=<nil> pk=0 hidden=0

-- table artwork
CREATE TABLE artwork (
	hash   BLOB    PRIMARY KEY CHECK (length(hash) = 32), -- SHA-256 of the source image; names the files
	width  INTEGER NOT NULL,                              -- of the source
	height INTEGER NOT NULL,
	accent TEXT    NOT NULL,                              -- #rrggbb
	ground TEXT    NOT NULL,                              -- #rrggbb
	source TEXT    NOT NULL CHECK (source IN ('embedded', 'folder'))
) STRICT, WITHOUT ROWID;
--   column cid=0 name=hash type=BLOB notnull=1 dflt_value=<nil> pk=1 hidden=0
--   column cid=1 name=width type=INTEGER notnull=1 dflt_value=<nil> pk=0 hidden=0
--   column cid=2 name=height type=INTEGER notnull=1 dflt_value=<nil> pk=0 hidden=0
--   column cid=3 name=accent type=TEXT notnull=1 dflt_value=<nil> pk=0 hidden=0
--   column cid=4 name=ground type=TEXT notnull=1 dflt_value=<nil> pk=0 hidden=0
--   column cid=5 name=source type=TEXT notnull=1 dflt_value=<nil> pk=0 hidden=0

-- table lastfm_accounts
CREATE TABLE lastfm_accounts (
	user_id      INTEGER PRIMARY KEY REFERENCES users (id) ON DELETE CASCADE,
	name         TEXT    NOT NULL, -- the Last.fm user name
	session_key  TEXT    NOT NULL, -- as Last.fm gave it: as sensitive as a password, it never leaves the server
	scrobble     INTEGER NOT NULL CHECK (scrobble IN (0, 1)),
	now_playing  INTEGER NOT NULL CHECK (now_playing IN (0, 1)),
	loves        INTEGER NOT NULL CHECK (loves IN (0, 1)),
	state        TEXT    NOT NULL CHECK (state IN ('ok', 'reconnect')),
	connected_at INTEGER NOT NULL,
	last_sent_at INTEGER -- the latest send Last.fm took; NULL before the first
) STRICT;
--   column cid=0 name=user_id type=INTEGER notnull=0 dflt_value=<nil> pk=1 hidden=0
--   column cid=1 name=name type=TEXT notnull=1 dflt_value=<nil> pk=0 hidden=0
--   column cid=2 name=session_key type=TEXT notnull=1 dflt_value=<nil> pk=0 hidden=0
--   column cid=3 name=scrobble type=INTEGER notnull=1 dflt_value=<nil> pk=0 hidden=0
--   column cid=4 name=now_playing type=INTEGER notnull=1 dflt_value=<nil> pk=0 hidden=0
--   column cid=5 name=loves type=INTEGER notnull=1 dflt_value=<nil> pk=0 hidden=0
--   column cid=6 name=state type=TEXT notnull=1 dflt_value=<nil> pk=0 hidden=0
--   column cid=7 name=connected_at type=INTEGER notnull=1 dflt_value=<nil> pk=0 hidden=0
--   column cid=8 name=last_sent_at type=INTEGER notnull=0 dflt_value=<nil> pk=0 hidden=0
--   foreign key id=0 seq=0 table=users from=user_id to=id on_update=NO ACTION on_delete=CASCADE match=NONE

-- table lastfm_outbox
CREATE TABLE lastfm_outbox (
	id       INTEGER PRIMARY KEY, -- the order things happened in, and are sent in
	user_id  INTEGER NOT NULL REFERENCES lastfm_accounts (user_id) ON DELETE CASCADE,
	kind     TEXT    NOT NULL CHECK (kind IN ('scrobble', 'love', 'unlove')),
	track_id INTEGER NOT NULL REFERENCES tracks (id) ON DELETE CASCADE,
	at       INTEGER NOT NULL, -- when the play started, or when the heart changed
	attempts INTEGER NOT NULL, -- sends that failed for a reason that passes
	next_at  INTEGER NOT NULL  -- not sent before; never less than an earlier row's of the same user
) STRICT;
--   column cid=0 name=id type=INTEGER notnull=0 dflt_value=<nil> pk=1 hidden=0
--   column cid=1 name=user_id type=INTEGER notnull=1 dflt_value=<nil> pk=0 hidden=0
--   column cid=2 name=kind type=TEXT notnull=1 dflt_value=<nil> pk=0 hidden=0
--   column cid=3 name=track_id type=INTEGER notnull=1 dflt_value=<nil> pk=0 hidden=0
--   column cid=4 name=at type=INTEGER notnull=1 dflt_value=<nil> pk=0 hidden=0
--   column cid=5 name=attempts type=INTEGER notnull=1 dflt_value=<nil> pk=0 hidden=0
--   column cid=6 name=next_at type=INTEGER notnull=1 dflt_value=<nil> pk=0 hidden=0
--   foreign key id=0 seq=0 table=tracks from=track_id to=id on_update=NO ACTION on_delete=CASCADE match=NONE
--   foreign key id=1 seq=0 table=lastfm_accounts from=user_id to=user_id on_update=NO ACTION on_delete=CASCADE match=NONE

-- index lastfm_outbox_due
CREATE INDEX lastfm_outbox_due ON lastfm_outbox (user_id, next_at, id);
--   key seqno=0 cid=1 name=user_id desc=0 coll=BINARY key=1
--   key seqno=1 cid=6 name=next_at desc=0 coll=BINARY key=1
--   key seqno=2 cid=0 name=id desc=0 coll=BINARY key=1
--   key seqno=3 cid=-1 name=<nil> desc=0 coll=BINARY key=0

-- index lastfm_outbox_track
CREATE INDEX lastfm_outbox_track ON lastfm_outbox (track_id);
--   key seqno=0 cid=3 name=track_id desc=0 coll=BINARY key=1
--   key seqno=1 cid=-1 name=<nil> desc=0 coll=BINARY key=0

-- table listens
CREATE TABLE listens (
	user_id     INTEGER NOT NULL REFERENCES users (id) ON DELETE CASCADE,
	track_id    INTEGER NOT NULL REFERENCES tracks (id) ON DELETE CASCADE,
	client_id   TEXT    NOT NULL, -- chosen by the client, so a start and its end are one row, however often sent
	shuffle     TEXT    NOT NULL, -- the shuffle session's ID, or '' for a listen outside one
	started_at  INTEGER NOT NULL, -- by the client's clock, never ahead of the server's
	listened_ms INTEGER NOT NULL CHECK (listened_ms >= 0), -- how much of it played
	duration_ms INTEGER NOT NULL, -- the track's, as the listen began
	-- How it ended; NULL while it is under way, or if its end never arrived.
	ended       TEXT    CHECK (ended IN ('completed', 'skipped', 'stopped', 'interrupted')),
	UNIQUE (user_id, client_id)
) STRICT;
--   column cid=0 name=user_id type=INTEGER notnull=1 dflt_value=<nil> pk=0 hidden=0
--   column cid=1 name=track_id type=INTEGER notnull=1 dflt_value=<nil> pk=0 hidden=0
--   column cid=2 name=client_id type=TEXT notnull=1 dflt_value=<nil> pk=0 hidden=0
--   column cid=3 name=shuffle type=TEXT notnull=1 dflt_value=<nil> pk=0 hidden=0
--   column cid=4 name=started_at type=INTEGER notnull=1 dflt_value=<nil> pk=0 hidden=0
--   column cid=5 name=listened_ms type=INTEGER notnull=1 dflt_value=<nil> pk=0 hidden=0
--   column cid=6 name=duration_ms type=INTEGER notnull=1 dflt_value=<nil> pk=0 hidden=0
--   column cid=7 name=ended type=TEXT notnull=0 dflt_value=<nil> pk=0 hidden=0
--   foreign key id=0 seq=0 table=tracks from=track_id to=id on_update=NO ACTION on_delete=CASCADE match=NONE
--   foreign key id=1 seq=0 table=users from=user_id to=id on_update=NO ACTION on_delete=CASCADE match=NONE

-- index listens_history
CREATE INDEX listens_history ON listens (user_id, track_id);
--   key seqno=0 cid=0 name=user_id desc=0 coll=BINARY key=1
--   key seqno=1 cid=1 name=track_id desc=0 coll=BINARY key=1
--   key seqno=2 cid=-1 name=<nil> desc=0 coll=BINARY key=0

-- index listens_recent
CREATE INDEX listens_recent ON listens (user_id, started_at);
--   key seqno=0 cid=0 name=user_id desc=0 coll=BINARY key=1
--   key seqno=1 cid=4 name=started_at desc=0 coll=BINARY key=1
--   key seqno=2 cid=-1 name=<nil> desc=0 coll=BINARY key=0

-- index listens_track
CREATE INDEX listens_track ON listens (track_id);
--   key seqno=0 cid=1 name=track_id desc=0 coll=BINARY key=1
--   key seqno=1 cid=-1 name=<nil> desc=0 coll=BINARY key=0

-- table plays
CREATE TABLE plays (
	user_id   INTEGER NOT NULL REFERENCES users (id) ON DELETE CASCADE,
	track_id  INTEGER NOT NULL REFERENCES tracks (id) ON DELETE CASCADE,
	played_at INTEGER NOT NULL, -- when the listen started, by the client's clock, never ahead of the server's
	source    TEXT    NOT NULL, -- the client's name
	client_id TEXT    NOT NULL, -- chosen by the client, so a retry counts once
	UNIQUE (user_id, client_id)
) STRICT;
--   column cid=0 name=user_id type=INTEGER notnull=1 dflt_value=<nil> pk=0 hidden=0
--   column cid=1 name=track_id type=INTEGER notnull=1 dflt_value=<nil> pk=0 hidden=0
